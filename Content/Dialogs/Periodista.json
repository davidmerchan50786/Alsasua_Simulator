            ]
        },
        {
            "ID": 3,
            "Type": "NPC_Statement",
            "DialogueText": "¿El gobierno miente? Dame las pruebas y yo hago el resto. Mi artículo puede hacer temblar al poder.",
            "Options": [
                {
                    "OptionText": "Toma esto.",
                    "TargetNodeID": 5,
                    "bRequiresSkillCheck": false,
                    "DifficultyClass": 10
                }
            ]
        },
        {
            "ID": 4,
            "Type": "End_Conversation",
            "DialogueText": "Vale, entiendo. Si cambias de opinión, ya sabes dónde encontrarme."
        },
        {
            "ID": 5,
