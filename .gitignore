# Unreal Engine — carpetas generadas (no versionar)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj/
*.xcworkspace/

# Conserva la estructura de Content aunque esté vacía
!Content/

# Content pesado (assets importados, mapa, lidar raw): fuera de git
Content/AssetsImportados/
Content/External/
Content/CitySample/
Content/Materiales/
Content/Road/

# Regenerados por UAlsasuaAssetGenerator::GenerarTodosLosAssets() — mismo
# criterio que Content/Materiales/: mallas procedurales, no assets de origen.
Content/Landmarks/
Content/Meshes/
Content/Mobiliario/

# Descargas de Fab / biblioteca de Epic (Megascans, packs del launcher).
# Son decenas de GB de .uasset: cada quien las baja con el plugin Fab.
Content/Megascans/
Content/MSPresets/
Content/Fab/
Content/GASP/
Content/Characters/Megascans/
Content/Maps/*.umap
Content/Maps/*.uasset
Content/__ExternalActors__/
Content/__ExternalObjects__/
Content/Terreno/*.raw
Content/Terreno/*.xyz
Content/Terreno/T_Satelite_Alsasua.uasset
Content/Terreno/alsasua_satelite.jpg

# Ortofoto del relieve lejano (29 MB). Iría por LFS como las otras dos, pero la
# cuenta tiene el presupuesto de LFS de GitHub agotado y el push la rechaza.
# La regenera Tools/DescargarRelieveLejano.py en ~80 s desde el IGN. Si algún día
# se amplía el presupuesto, quita esta línea y añádela a .gitattributes.
Content/Terreno/alsasua_relieve_lejano_4096.png

# uassets de textura derivados (reimportables desde los PNG con ImportSatellite.py)
Content/Textures/*.uasset

# Python (Tools)
__pycache__/
*.pyc

# Plugins descargados de terceros (p. ej. Cesium): versiona sólo si lo decides
# Plugins/CesiumForUnreal/

# Texturas 8K y ramas SKM: 1,4 GB que rebasaban el presupuesto de LFS. Fuera de git; se bajan del pack original.
Content/UnrealDrive_CitySample/Textures/
Content/Megaplant_Library/Tree_Norway_Spruce/Instances/SKM_Branch_Norway_Spruce_02.uasset

# Packs descargables (10 GB): fuera de git, se rebajan del Fab/Marketplace
Content/UnrealDrive_CitySample/
Content/Megaplant_Library/
Content/VehicleVarietyPack/
Content/GV_FreeShrubsPack/
Content/DZ_Assets/
Content/OWD_Flowers_Pack/
Content/Man/
Content/FreeAnimationLibrary/
Content/Nanite_Plants_Sample_Collection/
Content/Vefects/
Content/HighPoly_Tree_Model/

# Packs crudos sin importar (FBX/7z masters): los .uasset importados SI van al
# repo; estos originales no, y con el presupuesto de LFS agotado tampoco podrian.
# Vuelven a descargarse de su origen cuando toque reimportar algo.
Content/Docks/
Content/LUTs/
Content/Pack_Bonus/
Content/Polyart/
Content/Realistic_Starter_VFX_Pack_Vol2/

# Estado local de herramientas externas
.abacusai/
