# Unreal Engine — carpetas generadas (no versionar)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj/
*.xcworkspace/

# Conserva la estructura de Content aunque esté vacía
!Content/

# Content pesado (assets importados, mapa, lidar raw): fuera de git
Content/AssetsImportados/
Content/CitySample/
Content/Materiales/
Content/Road/
Content/Maps/*.umap
Content/Maps/*.uasset
Content/__ExternalActors__/
Content/__ExternalObjects__/
Content/Terreno/*.raw
Content/Terreno/*.xyz
Content/Terreno/T_Satelite_Alsasua.uasset
Content/Terreno/alsasua_satelite.jpg

# uassets de textura derivados (reimportables desde los PNG con ImportSatellite.py)
Content/Textures/*.uasset

# Python (Tools)
__pycache__/
*.pyc

# Plugins descargados de terceros (p. ej. Cesium): versiona sólo si lo decides
# Plugins/CesiumForUnreal/
